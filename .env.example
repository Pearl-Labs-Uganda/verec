# VEREC Backend Configuration

# ── Vision-Language Model Backend ────────────────────────────────────────
# Set to "true" to use Qwen2.5-VL via Ollama instead of local FastVLM
# Requires: ollama installed and qwen2.5-vl model pulled
USE_QWEN_VL=false

# Ollama server URL (only used if USE_QWEN_VL=true)
OLLAMA_URL=http://localhost:11434

# Local VLM model path (used if USE_QWEN_VL=false)
VLM_MODEL_PATH=checkpoints/llava-fastvithd_0.5b_stage3

# ── CORS Settings ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the backend API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000

# ── Optional: OpenAI API (for AI Chat tab in frontend) ───────────────────
# OPENAI_API_KEY=your-key-here

# ── Frontend Build Settings ───────────────────────────────────────────────
# Backend API URL (baked into frontend at build time)
# Change this when deploying to production
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Advanced: Model Paths ─────────────────────────────────────────────────
# Uncomment and customize if you want to use different model paths

# YOLO_MODEL_PATH=yolo11n.onnx
# YOLO_POSE_MODEL_PATH=yolo11n-pose.onnx
# STGCN_CHECKPOINT=checkpoints/stgcn_ntu60_joint.pth
