# ── API Keys & Credentials ────────────────────────────────────────────────
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.
#   cp .env.example .env

# Gradio app login (set to enable auth, leave blank to disable)
DEMO_USERNAME=
DEMO_PASSWORD=

# OpenAI (for AI Chat tab)
OPENAI_API_KEY=

# Ollama (for Reasoning tab — usually no key needed)
OLLAMA_URL=http://localhost:11434
